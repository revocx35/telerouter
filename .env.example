# Copy to .env and adjust. Everything else is configured in the web UI.

# Extra names/IPs for telerouter's self-signed certificate (its own IPs and hostname are added automatically)
#TELEROUTER_TLS_NAMES=telerouter.lan,192.168.1.50
# Or use your own certificate (PEM files inside /data)
#TELEROUTER_TLS_CERT=/data/own/cert.pem
#TELEROUTER_TLS_KEY=/data/own/key.pem

#TELEROUTER_HTTPS_PORT=8443
#TELEROUTER_SIP_PORT=5080
#TELEROUTER_RTP_PORT_MIN=18000
#TELEROUTER_RTP_PORT_MAX=18199
# Address put into SIP/SDP when the automatic choice is wrong (e.g. several interfaces)
#TELEROUTER_ADVERTISE_IP=192.168.1.50
# Loopback port the agents' SSH reverse tunnels connect to (MCP)
#TELEROUTER_INTERNAL_PORT=47700

# Reverse proxies whose X-Forwarded-For is trusted: "private" (RFC 1918) or CIDRs, comma separated
#TELEROUTER_TRUSTED_PROXIES=
# Fixed setup code for the first admin account (otherwise a random one is logged at first start)
#TELEROUTER_SETUP_CODE=
#TELEROUTER_LOG_LEVEL=INFO

# Speech services
#WHISPER_MODEL=small-int8          # tiny-int8 | base-int8 | small-int8 | medium-int8
#WHISPER_THREADS=4
# Words Whisper should expect (names you say often); keep it short
#WHISPER_PROMPT=Hey Jarvis. Call dad. Call mom. Hang up.
#PIPER_VOICE=en_US-lessac-medium   # default voice (the UI can pick others; they download on first use)
#WAKE_THRESHOLD=0.5
